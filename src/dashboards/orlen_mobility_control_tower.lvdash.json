{
  "datasets": [
    {
      "name": "site_overview",
      "displayName": "Destination operating state",
      "queryLines": [
        "SELECT Site AS site_id, `Operating Status` AS operating_status, `Hero Trigger Active` AS hero_trigger_active, MEASURE(`Available Chargers`) AS available_chargers, MEASURE(`Expected Wait Minutes`) AS expected_wait_minutes, MEASURE(`At Risk Sites`) AS at_risk_sites FROM mobility_mv_site_performance GROUP BY ALL"
      ]
    },
    {
      "name": "hero_site",
      "displayName": "Hero destination",
      "queryLines": [
        "SELECT Site AS site_id, `Operating Status` AS operating_status, MEASURE(`Available Chargers`) AS available_chargers, MEASURE(`Expected Wait Minutes`) AS expected_wait_minutes, MEASURE(`At Risk Sites`) AS at_risk_sites FROM mobility_mv_site_performance WHERE Site = 'SITE-00007' GROUP BY ALL"
      ]
    },
    {
      "name": "hero_risk",
      "displayName": "Hero charger risk",
      "queryLines": [
        "SELECT Site AS site_id, MEASURE(`Average Failure Probability`) AS avg_failure_probability, MEASURE(`High Risk Predictions`) AS high_risk_predictions FROM mobility_mv_charger_risk WHERE Site = 'SITE-00007' GROUP BY ALL"
      ]
    },
    {
      "name": "energy_value",
      "displayName": "Multi-energy and convenience value",
      "queryLines": [
        "SELECT `Energy Type` AS energy_type, `Service Type` AS service_type, MEASURE(`Energy KWh`) AS energy_kwh, MEASURE(`Convenience Revenue EUR`) AS convenience_revenue_eur, MEASURE(`Total Revenue EUR`) AS total_revenue_eur, MEASURE(`Margin Proxy EUR`) AS margin_proxy_eur FROM mobility_mv_energy_retail_performance GROUP BY ALL"
      ]
    },
    {
      "name": "journey_value",
      "displayName": "Customer journey value",
      "queryLines": [
        "SELECT `Customer Segment` AS customer_segment, MEASURE(`Completed Journeys`) AS completed_journeys, MEASURE(`Average Wait Minutes`) AS average_wait_minutes, MEASURE(`Journey Completion Rate`) AS completion_rate, MEASURE(`Journey Margin Proxy EUR`) AS margin_proxy_eur FROM mobility_mv_customer_journey_value GROUP BY ALL"
      ]
    },
    {
      "name": "charger_risk_all",
      "displayName": "Charger risk by destination",
      "queryLines": [
        "SELECT Site AS site_id, Charger AS charger_id, `Risk Band` AS risk_band, `Scored Time` AS scored_time, MEASURE(`Average Failure Probability`) AS avg_failure_probability, MEASURE(`High Risk Predictions`) AS high_risk_predictions FROM mobility_mv_charger_risk GROUP BY ALL"
      ]
    }
  ],
